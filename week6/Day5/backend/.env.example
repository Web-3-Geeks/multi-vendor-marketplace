# Development settings. Copy to .env and fill in the values:  cp .env.example .env
# For production, see .env.production.example (set the values in the Vercel dashboard instead of a file).

# ---- Server ----------------------------------------------------------------
PORT=5000
# development | production | test. In production Mongoose does NOT auto-build indexes
# (run `npm run db:setup` once instead) and error details are never sent to clients.
NODE_ENV=development

# ---- Database --------------------------------------------------------------
# MongoDB connection string INCLUDING the database name, e.g.
# mongodb+srv://user:password@cluster.mongodb.net/marketplace
# Transactions (checkout, payments) need a replica set; Atlas always is one.
DATABASE_URL=your_mongodb_connection_string

# ---- Auth ------------------------------------------------------------------
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret

# ---- URLs ------------------------------------------------------------------
# The ONLY browser origin CORS allows (no trailing slash).
FRONTEND_URL=http://localhost:5173
# This API's own public base URL (used in docs / webhook setup).
BACKEND_URL=http://localhost:5000

# ---- Payments --------------------------------------------------------------
# mock = built-in test provider, no real money, nothing to sign up for.
# See README -> "Switching to a real payment provider" for Stripe test mode.
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=pk_test_mock_123
# Server only. Never returned by any endpoint, never sent to the frontend.
PAYMENT_SECRET_KEY=sk_test_mock_123
# Signs and verifies webhook calls. Generate one with:
#   node -e "console.log('whsec_' + require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=whsec_mock_change_this_to_a_long_random_string

# Platform commission as a fraction between 0 and 1 (0.10 = 10%). Defaults to 0.10.
COMMISSION_RATE=0.10

# ---- Seed script (npm run seed) --------------------------------------------
# Passwords for the demo admin@test.com and vendor@test.com accounts.
SEED_ADMIN_PASSWORD=seed_admin_password
SEED_VENDOR_PASSWORD=seed_vendor_password

# ---- Demo data (npm run seed:demo) -----------------------------------------
# Not read from .env: pass DEMO_PASSWORD and ADMIN_PASSWORD on the command line (see README -> Demo data).

# ---- Optional --------------------------------------------------------------
# true switches off every rate limiter. For automated tests / local load runs ONLY.
# Never set it on a deployed server.
# RATE_LIMIT_DISABLED=false
# Setting any value makes Express trust one proxy hop for the client IP (needed for
# correct rate limiting behind a reverse proxy). Vercel is detected automatically, so
# set this only when running behind another proxy (nginx, a load balancer).
# TRUST_PROXY=1
# Set to "off" to silence the one-line-per-request log (method, path, status, ms).
# The log never contains query strings or request bodies.
# REQUEST_LOG=off
# Automated tests only: a database URL whose name ends in _test. When unset, the tests
# start a throw-away in-memory MongoDB, so you normally do not need this.
# TEST_DATABASE_URL=
