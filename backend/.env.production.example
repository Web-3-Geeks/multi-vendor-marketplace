# Production settings. Do NOT commit real values. Enter these in Vercel:
#   Project -> Settings -> Environment Variables -> Environment: Production
# Every value differs from development: new secrets, the live URLs, a production database.

NODE_ENV=production

# A SEPARATE database (or at least a separate database name) from development.
DATABASE_URL=mongodb+srv://prod_user:prod_password@cluster.mongodb.net/marketplace_prod

# New random value, not the one used in development. Rotating it logs everybody out.
JWT_SECRET=generate_a_new_96_character_hex_string

# The deployed frontend, exactly as the browser shows it: https, no trailing slash.
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.vercel.app

# mock is fine for a demo. For real card payments switch to a real provider
# (README -> "Switching to a real payment provider") and use that provider's LIVE keys.
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=pk_live_replace_me
PAYMENT_SECRET_KEY=sk_live_replace_me
# The provider's webhook signing secret for THIS deployment's webhook URL:
#   https://your-backend.vercel.app/api/payments/webhook
PAYMENT_WEBHOOK_SECRET=whsec_replace_me

COMMISSION_RATE=0.10

# Seed passwords are only needed on the one-off machine that runs `npm run seed`
# (use strong ones, then remove them). They are not read by the running server.
# SEED_ADMIN_PASSWORD=
# SEED_VENDOR_PASSWORD=

# Leave unset in production: RATE_LIMIT_DISABLED, TRUST_PROXY (Vercel sets it),
# TEST_DATABASE_URL.

# After the FIRST deploy, build the indexes once from your own machine, pointing
# DATABASE_URL at the production database:   npm run db:setup
